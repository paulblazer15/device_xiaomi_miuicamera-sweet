hal_client_domain(platform_app, vendor_hal_camerapostproc_xiaomi)
hal_client_domain(platform_app_36, vendor_hal_camerapostproc_xiaomi)

binder_use(platform_app_all)
binder_call(platform_app_all, hal_camera_default)
binder_call(platform_app_all, vendor_hal_camerapostproc_xiaomi)
allow platform_app_all vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
allow platform_app_all vendor_hal_misys_hwservice:hwservice_manager find;

allow platform_app_all adsprpcd_file:dir { open read search };
allow platform_app_all vendor_xdsp_device:chr_file { ioctl open read write };
allow platform_app_all vendor_qdsp_device:chr_file { ioctl open read write };

allow platform_app_all vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app_all vendor_camera_data_file:file { getattr open read };

allow platform_app_all app_data_file:file execute;

# Properties
get_prop(platform_app_all, vendor_audio_prop)
get_prop(platform_app_all, vendor_display_prop)
get_prop(platform_app_all, vendor_fp_prop)
